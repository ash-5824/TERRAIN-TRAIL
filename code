"use client";

import { useState, useEffect } from "react";
import { Loader2, MapPin, Camera, AlertTriangle, CheckCircle, AlertCircle, ShieldAlert } from "lucide-react";

type AnalysisResult = {
  risk_level: "Low" | "Moderate" | "Critical";
  hazard_type: string;
  safe_to_proceed: boolean;
  key_observations: string[];
  recommended_action: string;
};

const badgeStyles: Record<string, string> = {
  Low: "bg-green-600 text-white",
  Moderate: "bg-orange-500 text-white",
  Critical: "bg-red-600 text-white",
};

export default function Home() {
  const [location, setLocation] = useState<{ lat: number; lng: number } | null>(null);
  const [locationError, setLocationError] = useState<string | null>(null);
  const [locationLoading, setLocationLoading] = useState(false);

  const [imageFile, setImageFile] = useState<File | null>(null);
  const [uploadFile, setUploadFile] = useState<File | Blob | null>(null);
  const [imagePreviewUrl, setImagePreviewUrl] = useState<string | null>(null);
  const [imageError, setImageError] = useState<string | null>(null);
  const [isCompressing, setIsCompressing] = useState(false);

  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [analysisResult, setAnalysisResult] = useState<AnalysisResult | null>(null);

  // Cleanup object URLs to avoid memory leaks
  useEffect(() => {
    return () => {
      if (imagePreviewUrl) {
        URL.revokeObjectURL(imagePreviewUrl);
      }
    };
  }, [imagePreviewUrl]);

  // Geolocation trigger on explicit user button click
  const handleGetLocation = () => {
    setLocationError(null);
    if (!navigator.geolocation) {
      setLocationError("Geolocation is not supported by your browser.");
      return;
    }

    setLocationLoading(true);
    navigator.geolocation.getCurrentPosition(
      (position) => {
        setLocationLoading(false);
        setLocation({
          lat: position.coords.latitude,
          lng: position.coords.longitude,
        });
      },
      (err) => {
        setLocationLoading(false);
        let msg = "Unable to retrieve your location.";
        if (err.code === 1) msg = "Location permission denied. Please enable GPS permissions in your browser.";
        else if (err.code === 2) msg = "Location position unavailable. Check GPS signal.";
        else if (err.code === 3) msg = "Location request timed out. Please try again.";
        setLocationError(msg);
      },
      {
        enableHighAccuracy: true,
        timeout: 10000,
        maximumAge: 0,
      }
    );
  };

  // Compression helper with bounded 3-step retry (0.8 -> 0.6 -> 0.4)
  const compressImage = (file: File, maxSize: number): Promise<Blob | null> => {
    return new Promise((resolve) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const canvas = document.createElement("canvas");
        let { width, height } = img;
        const maxDim = 1920;
        if (width > maxDim || height > maxDim) {
          const ratio = Math.min(maxDim / width, maxDim / height);
          width = Math.floor(width * ratio);
          height = Math.floor(height * ratio);
        }
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext("2d");
        if (!ctx) return resolve(null);
        ctx.drawImage(img, 0, 0, width, height);

        let attempt = 0;
        const qualities = [0.8, 0.6, 0.4];

        const tryCompress = () => {
          if (attempt >= qualities.length) {
            resolve(null);
            return;
          }
          canvas.toBlob(
            (blob) => {
              if (!blob) {
                resolve(null);
                return;
              }
              if (blob.size < maxSize) {
                resolve(blob);
              } else {
                attempt++;
                tryCompress();
              }
            },
            "image/jpeg",
            qualities[attempt]
          );
        };
        tryCompress();
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        resolve(null);
      };
      img.src = url;
    });
  };

  const handleFileChange = async (e: React.ChangeEvent<HTMLInputElement>) => {
    setImageError(null);
    setError(null);
    setAnalysisResult(null);

    const file = e.target.files?.[0];
    if (!file) return;

    // Strict client-side format validation (Block HEIC / HEIF immediately before preview)
    const allowed = ["image/jpeg", "image/png", "image/webp"];
    if (!allowed.includes(file.type)) {
      setImageError(
        "That photo format isn't supported (HEIC/HEIF from some iPhone cameras isn't accepted). Please choose a JPEG or PNG photo instead, or check your camera's format setting."
      );
      if (imagePreviewUrl) {
        URL.revokeObjectURL(imagePreviewUrl);
        setImagePreviewUrl(null);
      }
      setImageFile(null);
      setUploadFile(null);
      return;
    }

    // Always create preview from the original, uncompressed file
    if (imagePreviewUrl) {
      URL.revokeObjectURL(imagePreviewUrl);
    }
    setImageFile(file);
    setImagePreviewUrl(URL.createObjectURL(file));

    const MAX_UPLOAD_SIZE = 4 * 1024 * 1024; // 4 MB target margin

    // Check if compression is required
    if (file.size < MAX_UPLOAD_SIZE) {
      setUploadFile(file);
      return;
    }

    // Run bounded client-side compression
    setIsCompressing(true);
    const compressed = await compressImage(file, MAX_UPLOAD_SIZE);
    setIsCompressing(false);

    if (!compressed) {
      setImageError("This photo is too large to upload even after compression. Please try a different photo or a lower-resolution shot.");
      setUploadFile(null);
    } else {
      setUploadFile(compressed);
    }
  };

  const handleSubmit = async () => {
    if (!uploadFile || !location) {
      setError("Both a photo and your location are required.");
      return;
    }

    setLoading(true);
    setError(null);
    setAnalysisResult(null);

    try {
      const formData = new FormData();
      formData.append("image", uploadFile);
      formData.append("latitude", String(location.lat));
      formData.append("longitude", String(location.lng));

      const res = await fetch("/api/analyze", {
        method: "POST",
        body: formData,
      });

      const data = await res.json();
      if (!res.ok) {
        setError(data.error || "An error occurred during analysis.");
      } else {
        setAnalysisResult(data);
      }
    } catch {
      setError("Network failure or unable to reach the server.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <main className="max-w-md mx-auto p-4 flex flex-col gap-5 min-h-screen">
      {/* Header */}
      <header className="text-center py-4 border-b border-gray-800">
        <h1 className="text-2xl font-bold flex items-center justify-center gap-2 text-white">
          <AlertTriangle className="text-orange-500 h-6 w-6" />
          Terrain & Trail Guard
        </h1>
        <p className="text-gray-400 text-sm mt-1">AI Terrain Hazard Assessment</p>
      </header>

      {/* Location Card */}
      <section className="bg-gray-900 rounded-xl p-4 border border-gray-800 shadow-md">
        <h2 className="text-base font-semibold mb-3 flex items-center gap-2 text-gray-200">
          <MapPin size={18} className="text-blue-400" /> Location Information
        </h2>
        {location ? (
          <div className="bg-gray-950 p-3 rounded-lg border border-gray-800 text-sm text-gray-300 flex items-center justify-between">
            <div>
              <div className="text-xs text-gray-500 uppercase tracking-wide font-semibold">Captured GPS Coordinates</div>
              <div className="font-mono text-sm mt-0.5">
                {location.lat.toFixed(5)}, {location.lng.toFixed(5)}
              </div>
            </div>
            <button
              onClick={handleGetLocation}
              disabled={locationLoading}
              className="text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 px-2.5 py-1.5 rounded transition-colors"
            >
              Update
            </button>
          </div>
        ) : (
          <button
            onClick={handleGetLocation}
            disabled={locationLoading}
            className="w-full bg-blue-600 hover:bg-blue-700 disabled:bg-blue-800 text-white font-medium py-3 px-4 rounded-lg transition-colors flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-gray-900"
          >
            {locationLoading ? (
              <>
                <Loader2 className="animate-spin h-4 w-4" />
                <span>Acquiring GPS Position...</span>
              </>
            ) : (
              <>
                <MapPin size={18} />
                <span>Get My Location</span>
              </>
            )}
          </button>
        )}
        {locationError && (
          <div className="mt-2.5 text-red-400 text-sm bg-red-950/40 border border-red-900/50 p-2.5 rounded-lg flex items-start gap-2">
            <AlertCircle className="h-4 w-4 shrink-0 mt-0.5" />
            <span>{locationError}</span>
          </div>
        )}
      </section>

      {/* Photo Card */}
      <section className="bg-gray-900 rounded-xl p-4 border border-gray-800 shadow-md">
        <h2 className="text-base font-semibold mb-3 flex items-center gap-2 text-gray-200">
          <Camera size={18} className="text-emerald-400" /> Terrain Photograph
        </h2>

        <label className="w-full bg-gray-800 hover:bg-gray-700 text-white font-medium py-3 px-4 rounded-lg transition-colors flex items-center justify-center gap-2 cursor-pointer mb-3 focus-within:ring-2 focus-within:ring-emerald-500 focus-within:ring-offset-2 focus-within:ring-offset-gray-900">
          <Camera size={18} />
          <span>Take Photo / Choose Image</span>
          <input
            type="file"
            accept="image/jpeg,image/png,image/webp"
            capture="environment"
            className="sr-only"
            onChange={handleFileChange}
          />
        </label>

        {isCompressing && (
          <div className="text-xs text-yellow-400 flex items-center gap-2 mb-3 bg-yellow-950/30 p-2 rounded border border-yellow-900/40">
            <Loader2 className="animate-spin h-3.5 w-3.5" /> Optimizing image for upload...
          </div>
        )}

        {imageError && (
          <div className="bg-red-950/40 border border-red-900 text-red-400 text-sm p-3 rounded-lg mb-3 flex items-start gap-2">
            <AlertCircle className="h-4 w-4 shrink-0 mt-0.5" />
            <span>{imageError}</span>
          </div>
        )}

        {imagePreviewUrl && (
          <div className="relative aspect-video rounded-lg overflow-hidden border border-gray-800 bg-black">
            {/* eslint-disable-next-line @next/next/no-img-element */}
            <img
              src={imagePreviewUrl}
              alt="Selected terrain preview for analysis"
              className="object-contain w-full h-full"
            />
          </div>
        )}
      </section>

      {/* Submit Action */}
      <button
        onClick={handleSubmit}
        disabled={loading || isCompressing || !uploadFile || !location}
        className="w-full bg-orange-600 hover:bg-orange-700 disabled:bg-gray-800 disabled:text-gray-500 text-white font-bold py-3.5 px-4 rounded-xl transition-colors flex items-center justify-center gap-2 shadow-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 focus:ring-offset-gray-950"
      >
        {loading ? (
          <>
            <Loader2 className="animate-spin h-5 w-5" />
            <span>Analyzing Terrain...</span>
          </>
        ) : (
          <span>Analyze Terrain</span>
        )}
      </button>

      {/* Global Error Banner */}
      {error && (
        <div className="bg-red-950/50 border border-red-900 text-red-300 p-4 rounded-xl flex items-start gap-2.5" aria-live="assertive">
          <ShieldAlert className="h-5 w-5 shrink-0 text-red-400 mt-0.5" />
          <div className="text-sm">
            <strong className="block font-semibold text-red-200">Analysis Error</strong>
            {error}
          </div>
        </div>
      )}

      {/* Result Card */}
      {analysisResult && (
        <section className="bg-gray-900 rounded-xl p-5 border border-gray-800 shadow-md flex flex-col gap-4" aria-live="polite">
          <div className="flex items-start justify-between border-b border-gray-800 pb-3">
            <h3 className="text-lg font-bold text-white">Hazard Assessment</h3>
            <span className={`px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${badgeStyles[analysisResult.risk_level] || "bg-gray-600 text-white"}`}>
              {analysisResult.risk_level} Risk
            </span>
          </div>

          <div>
            <div className="text-gray-400 text-xs uppercase font-semibold tracking-wider">Identified Hazard Type</div>
            <div className="font-semibold text-base text-gray-100 mt-0.5">{analysisResult.hazard_type}</div>
          </div>

          <div className="bg-gray-950 p-3.5 rounded-lg border border-gray-800">
            <div className="text-gray-400 text-xs uppercase font-semibold tracking-wider">Visual conditions assessment</div>
            <div className="font-medium flex items-center gap-2 mt-1">
              {analysisResult.safe_to_proceed ? (
                <div className="flex items-center gap-1.5 text-green-400 font-semibold">
                  <CheckCircle className="h-4 w-4" />
                  <span>No obvious visible hazard detected</span>
                </div>
              ) : (
                <div className="flex items-center gap-1.5 text-orange-400 font-semibold">
                  <AlertTriangle className="h-4 w-4" />
                  <span>Potential visible hazard detected</span>
                </div>
              )}
            </div>
            <p className="text-xs text-gray-400 mt-2 leading-relaxed">
              This is based only on visible conditions in the submitted image and does not guarantee that the route is safe.
            </p>
          </div>

          <div>
            <div className="text-gray-400 text-xs uppercase font-semibold tracking-wider mb-2">Key Visual Observations</div>
            <ul className="list-disc pl-5 space-y-1.5 text-sm text-gray-300">
              {analysisResult.key_observations.map((obs, i) => (
                <li key={i}>{obs}</li>
              ))}
            </ul>
          </div>

          <div className="bg-gray-950 p-3.5 rounded-lg border border-gray-800">
            <div className="text-gray-400 text-xs uppercase font-semibold tracking-wider mb-1">Recommended Action</div>
            <div className="text-sm font-medium text-gray-200 leading-relaxed">{analysisResult.recommended_action}</div>
          </div>
        </section>
      )}

      {/* Safety Disclaimer Footer */}
      <footer className="text-xs text-gray-500 text-center pb-8 border-t border-gray-800 pt-4 mt-auto">
        <p className="font-bold text-gray-400 mb-1">AI visual assessment only.</p>
        <p className="mb-1">Not an emergency directive or guarantee of real-world safety.</p>
        <p>Always follow local authority directives and on-site warnings.</p>
      </footer>
    </main>
  );
}
