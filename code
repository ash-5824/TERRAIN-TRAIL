import { NextRequest, NextResponse } from "next/server";
import { GoogleGenAI, Type } from "@google/genai";
import { initDB, sql } from "@/lib/db";

const MAX_BODY_SIZE = 4.5 * 1024 * 1024; // 4.5 MB request ceiling

export async function POST(request: NextRequest) {
  try {
    // 1. Enforce payload size limit at header level if present
    const contentLength = request.headers.get("content-length");
    if (contentLength && parseInt(contentLength, 10) > MAX_BODY_SIZE) {
      return NextResponse.json({ error: "Payload Too Large" }, { status: 413 });
    }

    let formData: FormData;
    try {
      formData = await request.formData();
    } catch {
      return NextResponse.json({ error: "Invalid form data in request" }, { status: 400 });
    }

    const imageFile = formData.get("image");
    const latitudeValue = formData.get("latitude");
    const longitudeValue = formData.get("longitude");

    // 2. Validate presence and types of required fields
    if (!imageFile || !(imageFile instanceof File) || imageFile.size === 0) {
      return NextResponse.json({ error: "Invalid or missing image file" }, { status: 400 });
    }

    if (latitudeValue === null || longitudeValue === null || latitudeValue === "" || longitudeValue === "") {
      return NextResponse.json({ error: "Missing coordinates" }, { status: 400 });
    }

    // 3. MIME type validation (Strict whitelist: JPEG, PNG, WebP. Reject HEIC/HEIF)
    const allowedMimeTypes = ["image/jpeg", "image/png", "image/webp"];
    if (!allowedMimeTypes.includes(imageFile.type)) {
      return NextResponse.json({ error: "Unsupported image format. Allowed formats: JPEG, PNG, WebP." }, { status: 400 });
    }

    // 4. Validate coordinates
    const latitude = Number(latitudeValue);
    const longitude = Number(longitudeValue);

    if (
      Number.isNaN(latitude) ||
      !Number.isFinite(latitude) ||
      latitude < -90 ||
      latitude > 90 ||
      Number.isNaN(longitude) ||
      !Number.isFinite(longitude) ||
      longitude < -180 ||
      longitude > 180
    ) {
      return NextResponse.json({ error: "Invalid coordinates (latitude must be between -90 and 90, longitude between -180 and 180)" }, { status: 400 });
    }

    // 5. In-code array buffer size check
    const arrayBuffer = await imageFile.arrayBuffer();
    if (arrayBuffer.byteLength > MAX_BODY_SIZE) {
      return NextResponse.json({ error: "Image too large" }, { status: 413 });
    }

    // 6. Check Gemini API configuration
    const apiKey = process.env.GEMINI_API_KEY;
    if (!apiKey || apiKey === "YOUR_API_KEY_HERE") {
      console.error("[Configuration Error] GEMINI_API_KEY is not configured or using placeholder value.");
      return NextResponse.json({ error: "Internal server error: AI service unconfigured" }, { status: 500 });
    }

    const ai = new GoogleGenAI({ apiKey });

    // 7. Define structured response schema
    const responseSchema = {
      type: Type.OBJECT,
      properties: {
        risk_level: {
          type: Type.STRING,
          enum: ["Low", "Moderate", "Critical"],
        },
        hazard_type: {
          type: Type.STRING,
        },
        safe_to_proceed: {
          type: Type.BOOLEAN,
        },
        key_observations: {
          type: Type.ARRAY,
          items: {
            type: Type.STRING,
          },
        },
        recommended_action: {
          type: Type.STRING,
        },
      },
      required: [
        "risk_level",
        "hazard_type",
        "safe_to_proceed",
        "key_observations",
        "recommended_action",
      ],
    };

    const systemInstruction = `You are an expert visual terrain-hazard assessment assistant.

Analyze the provided photograph for visible indicators associated with:
- landslides
- tension cracks
- mud flows
- unstable slopes
- rockfall potential
- debris
- visible road obstruction
- other clearly visible terrain hazards

The photograph is the primary evidence.

The provided GPS coordinates are geographic metadata only. Do not claim to know current weather, rainfall, geological stability, road closures, government warnings, satellite information, or other location-specific facts unless they are explicitly provided in the input.

Do not invent hazards that are not visually supported.

Do not treat absence of a visible hazard as proof that the area is safe.

Return ONLY valid JSON matching the provided response schema.

The "safe_to_proceed" field must be interpreted conservatively:
- true only when the photographed conditions show no obvious visible hazard and there is sufficient visual evidence to support that limited assessment
- false whenever a visible hazard exists or the image is insufficient/ambiguous for a reasonably cautious assessment

Even when safe_to_proceed is true, the recommendation must not imply a guarantee of real-world safety.`;

    const base64Image = Buffer.from(arrayBuffer).toString("base64");
    const mimeType = imageFile.type || "image/jpeg";

    let result;
    try {
      result = await ai.models.generateContent({
        model: "gemini-2.5-flash",
        contents: [
          {
            role: "user",
            parts: [
              {
                text: `Coordinates: latitude ${latitude}, longitude ${longitude}.`,
              },
              {
                inlineData: {
                  mimeType,
                  data: base64Image,
                },
              },
            ],
          },
        ],
        config: {
          responseMimeType: "application/json",
          responseSchema,
          systemInstruction,
        },
      });
    } catch (upstreamError) {
      console.error("[Gemini API Error]", upstreamError);
      return NextResponse.json({ error: "Failed to communicate with AI visual assessment service" }, { status: 502 });
    }

    const text = result?.text;
    if (!text) {
      return NextResponse.json({ error: "Model returned no content" }, { status: 502 });
    }

    let parsed: {
      risk_level: "Low" | "Moderate" | "Critical";
      hazard_type: string;
      safe_to_proceed: boolean;
      key_observations: string[];
      recommended_action: string;
    };

    try {
      parsed = JSON.parse(text);
    } catch (parseError) {
      console.error("[Model Output Parse Error]", parseError);
      return NextResponse.json({ error: "Model returned invalid JSON" }, { status: 502 });
    }

    // Defensive schema validation
    const isValid =
      ["Low", "Moderate", "Critical"].includes(parsed.risk_level) &&
      typeof parsed.hazard_type === "string" &&
      typeof parsed.safe_to_proceed === "boolean" &&
      Array.isArray(parsed.key_observations) &&
      parsed.key_observations.every((item) => typeof item === "string") &&
      typeof parsed.recommended_action === "string";

    if (!isValid) {
      console.error("[Model Output Schema Validation Failed]", parsed);
      return NextResponse.json({ error: "Model returned malformed schema" }, { status: 502 });
    }

    // 8. Database persistence (Graceful fallback if DB is unconfigured or fails)
    try {
      await initDB();
      const dbUrl = process.env.DATABASE_URL;
      if (dbUrl && !dbUrl.includes("placeholder")) {
        await sql`
          INSERT INTO hazard_reports (
            latitude,
            longitude,
            risk_level,
            hazard_type,
            safe_to_proceed,
            recommended_action
          ) VALUES (
            ${latitude},
            ${longitude},
            ${parsed.risk_level},
            ${parsed.hazard_type},
            ${parsed.safe_to_proceed},
            ${parsed.recommended_action}
          );
        `;
        console.log("[Database] Persisted hazard report successfully.");
      }
    } catch (dbError) {
      // Log server-side error, but DO NOT break the primary API response
      console.error("[Database Persistence Error]", dbError);
    }

    // 9. Return the verified analysis result
    return NextResponse.json(parsed, { status: 200 });
  } catch (error) {
    console.error("[Analyze API Handler Error]", error);
    return NextResponse.json({ error: "Internal server error" }, { status: 500 });
  }
}
