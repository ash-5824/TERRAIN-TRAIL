import { neon } from "@neondatabase/serverless";

// Fallback to empty string if DATABASE_URL is not set so neon client constructor does not crash on module load
const databaseUrl = process.env.DATABASE_URL || "";

export const sql = neon(databaseUrl);

export async function initDB(): Promise<void> {
  try {
    if (!databaseUrl || databaseUrl.includes("placeholder")) {
      console.warn("[Database] DATABASE_URL is not configured or is using placeholder values. Skipping live DB table init.");
      return;
    }

    await sql`
      CREATE TABLE IF NOT EXISTS hazard_reports (
        id SERIAL PRIMARY KEY,
        latitude FLOAT NOT NULL,
        longitude FLOAT NOT NULL,
        risk_level TEXT NOT NULL,
        hazard_type TEXT NOT NULL,
        safe_to_proceed BOOLEAN NOT NULL,
        recommended_action TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
      );
    `;
    console.log("[Database] Initialized table 'hazard_reports' successfully.");
  } catch (error) {
    console.error("[Database] Error initializing database schema:", error);
  }
}
